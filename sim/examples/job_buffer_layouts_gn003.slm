#!/usr/bin/bash -l

#SBATCH --job-name buf-gh
#SBATCH --time 06:00:00
#SBATCH --partition gracehopper
#SBATCH --account do016
#SBATCH --exclusive
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=72
#SBATCH --output buf-gh_%x_%j.out

# GPU transfer buffer layout comparison on Grace Hopper (gn003, aarch64),
# global-var particle access.
#
# The gracehopper partition has a 6 h time limit, so the work is split into
# separate jobs selected by MODE:
#
#   MODE=build  build all executables for BUFFER on the node (-march=native)
#   MODE=run    replay the 5-step logs of experiment DIR for BUFFER
#   MODE=env    only select and print the toolchain (exit 2 if incomplete)
#
# Both are resumable: existing executables and results are skipped, so a job
# that hits the time limit can simply be resubmitted. Submit from the directory
# where results should go, e.g. (see the end of this file):
#
#   sbatch --export=ALL,MODE=build,BUFFER=soa,REPO=/path/to/swiftgpupacksim job_buffer_layouts_gn003.slm
#   sbatch --export=ALL,MODE=run,BUFFER=soa,DIR=EAGLE25_72threads,REPO=... job_buffer_layouts_gn003.slm
#
# Results: <submit dir>/<NODE>_5steps_buffer-<BUFFER>/<DIR>_global-var_<split>_noflush/results_<layout>.csv
#
# Without Slurm (e.g. on gn002, see run_gn002.sh): set NODE=gn002 and run the
# script with `bash -l` from the results directory. NODE names the executables,
# build, work and result folders, so results of different nodes never mix; it
# must match the host name (ALLOW_NODE_MISMATCH=1 for tests only).
# Optional: LOAD_LOG=<file> appends a load snapshot (uptime, top 5 processes,
# GPU compute apps) before and after every run; STATUS_FILE=<file> gets a
# `last_finished_run=` line after every run.

set -e

: "${MODE:?set MODE=build or MODE=run}"
: "${BUFFER:?set BUFFER=aos or BUFFER=soa}"
: "${REPO:?set REPO to the swiftgpupacksim repository root}"

NODE="${NODE:-gn003}"
if [[ "$(hostname -s)" != "$NODE" && "${ALLOW_NODE_MISMATCH:-0}" != "1" ]]; then
  echo "ERROR: NODE=$NODE but running on $(hostname -s)"
  exit 2
fi
# logs were recorded on gn002
DATANODE=gn002
RUNDIR="${SLURM_SUBMIT_DIR:-$PWD}"
BINDIR="$RUNDIR/bin_${NODE}"

# ---------------------------------------------------------------------------
# Toolchain. No module collection for Grace Hopper is available to us and the
# login node shows no aarch64 CUDA, so the build job finds it on the node:
#   compiler: GH_MODULES (default: the clang module meant for Grace nodes,
#             which only sets CC=clang; falls back to gcc if there is no clang).
#             It must support OpenMP 5.1 `omp error` (clang >= 18, gcc >= 12),
#             otherwise the job stops with exit code 2.
#   CUDA and likwid-pin: selected by sim/examples/gh_toolchain.sh (read from
#             $REPO at job start). The login environment exported by Slurm
#             contains x86_64 modules (e.g. an x86_64 nvcc on PATH), so after
#             `module purge` x86_64 PATH entries are dropped, and candidates are
#             accepted only if they are native binaries that run. CUDA order:
#             GH_CUDA, /usr/local/cuda-13.0, /usr/local/cuda (resolved), newest
#             /usr/local/cuda-*, cuda/nvhpc modules (newest first).
#   If no CUDA is found the job stops with exit code 2 (no fallback to
#   building without cudaMallocHost, which would time a different code path).
# ---------------------------------------------------------------------------
TOOLCHAIN_ENV="$BINDIR/toolchain_${BUFFER}.env"
if [[ "$MODE" == "run" ]]; then
  [[ -f "$TOOLCHAIN_ENV" ]] || { echo "missing $TOOLCHAIN_ENV (run the build job first)"; exit 2; }
  echo "loading toolchain from $TOOLCHAIN_ENV"; cat "$TOOLCHAIN_ENV"
  # shellcheck disable=SC1090
  source "$TOOLCHAIN_ENV"
fi

# shellcheck disable=SC1091
source "$REPO/sim/examples/gh_toolchain.sh"

GH_MODULES="${GH_MODULES:-clang/18.1.8arm}"
module purge
gh_strip_foreign_paths
for m in $GH_MODULES; do module load "$m"; done
# cuda/nvhpc modules set CC (and CXX, CPP, FC, ...) to their own compilers;
# keep what GH_MODULES set up and restore it after loading CUDA.
COMPILER_VARS="CC CXX CPP FC F90 F77"
for v in $COMPILER_VARS; do
  if [[ -n "${!v+x}" ]]; then eval "SAVED_$v=\"\${$v}\""; else eval "unset SAVED_$v"; fi
done

gh_find_cuda || true
for v in $COMPILER_VARS; do
  sv="SAVED_$v"
  if [[ -n "${!sv+x}" ]]; then export "$v=${!sv}"; else unset "$v"; fi
done
CC="${CC:-cc}"
# clang/18.1.8arm only sets CC=clang and relies on a clang on the node.
if ! command -v "$CC" > /dev/null; then
  echo "WARNING: CC=$CC not found on $(hostname), falling back to gcc"
  export CC=gcc
fi
# The code needs OpenMP 5.1 `#pragma omp error` (src/swift_placeholders/error.h);
# e.g. gcc 11 (RHEL 9 system gcc) does not support it.
if ! printf '#include <omp.h>\nint main(void){\n#pragma omp error at(execution) severity(fatal) message("x")\nreturn omp_get_max_threads() < 0;}\n' |
  "$CC" -fopenmp -Werror=unknown-pragmas -x c - -o /dev/null; then
  echo "ERROR: C compiler '$CC' ($("$CC" --version 2>&1 | head -1)) cannot build an OpenMP" \
    "program with '#pragma omp error' on $(hostname). Set GH_MODULES to a compiler module" \
    "that provides clang >= 18 or gcc >= 12 for aarch64 and resubmit."
  exit 2
fi

gh_find_likwid_pin || true

env_summary() {
  echo "=== environment summary ($(date -Is))"
  echo "host: $(hostname), arch: $(uname -m), job: ${SLURM_JOB_ID:-none}, mode: $MODE, buffer: $BUFFER"
  echo "repo: $REPO @ $(git -C "$REPO" rev-parse --short HEAD) ($(git -C "$REPO" rev-parse --abbrev-ref HEAD))"
  echo "--- module list"; module -t list 2>&1
  echo "--- compiler: CC=$CC ($(command -v "$CC" || echo 'not found'))"
  "$CC" --version 2>&1 | head -1
  echo "--- CUDA: ${GH_CUDA:-NOT FOUND} (source: ${CUDA_SOURCE:-none}, module: ${GH_CUDA_MODULE:-none})"
  if [[ -n "${GH_CUDA:-}" ]]; then
    echo "nvcc: $GH_CUDA/bin/nvcc"; "$GH_CUDA/bin/nvcc" --version 2>&1 | tail -2
    file -L "$GH_CUDA/bin/nvcc"
  fi
  echo "--- likwid-pin: ${LIKWID_PIN:-NOT FOUND}"
  if [[ -n "${LIKWID_PIN:-}" ]]; then
    "$LIKWID_PIN" -v 2>&1 | grep -i version | head -1
    file -L "$(dirname "$(readlink -f "$LIKWID_PIN")")/likwid-lua"
  fi
  echo "--- cpu / gpu"; lscpu | grep -E "Architecture|Model name"
  nvidia-smi -L 2>&1 || true
  echo "=== end of environment summary"
}
env_summary

if [[ -z "${GH_CUDA:-}" ]] || ! gh_cuda_ok "$GH_CUDA"; then
  echo "ERROR: no working native CUDA found on $(hostname) ($(gh_arch)). Tried: GH_CUDA," \
    "/usr/local/cuda-13.0, /usr/local/cuda, /usr/local/cuda-*, cuda/nvhpc modules."
  echo "Seen:"; ls -d /usr/local/cuda* /opt/nvidia* 2>&1
  module -t avail 2>&1 | grep -i -E "cuda|nvhpc" || true
  echo "Set GH_CUDA=<cuda root> (and GH_CUDA_MODULE if a module is needed) and resubmit."
  exit 2
fi
export LD_LIBRARY_PATH="$GH_CUDA/lib64:${LD_LIBRARY_PATH:-}"
CUDA_FLAG="--cuda $GH_CUDA"

# -march=native as on dine2; clang on aarch64 may only accept -mcpu=native.
if [[ -z "${MYCFLAGS:-}" ]]; then
  if echo 'int main(void){return 0;}' | "$CC" -march=native -x c - -o /dev/null 2> /dev/null; then
    export MYCFLAGS="-march=native"
  else
    export MYCFLAGS="-mcpu=native"
  fi
fi
echo "MYCFLAGS=$MYCFLAGS"

if [[ "$MODE" == "run" ]]; then
  [[ -n "${LIKWID_PIN:-}" ]] || { echo "ERROR: no native likwid-pin found"; exit 1; }
  # check that pinning works on this node before starting the replay
  "$LIKWID_PIN" -c N:0 true || { echo "likwid-pin does not work here"; exit 1; }
fi


load_snapshot() {
  [[ -n "${LOAD_LOG:-}" ]] || return 0
  {
    echo "=== $(date -Is) $1"
    uptime
    ps -eo user,pcpu,pmem,etime,comm --sort=-pcpu | head -6
    nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv 2>&1
  } >> "$LOAD_LOG"
}

if [[ "$MODE" == "env" ]]; then

  [[ -n "${LIKWID_PIN:-}" ]] || { echo "ERROR: no native likwid-pin found"; exit 2; }
  echo "toolchain OK"

elif [[ "$MODE" == "build" ]]; then

  BUILDDIR="$RUNDIR/build_${NODE}_${BUFFER}"
  mkdir -p "$BUILDDIR" "$BINDIR"
  env_summary > "$BUILDDIR/build.log" 2>&1
  echo "MYCFLAGS=$MYCFLAGS" >> "$BUILDDIR/build.log"
  rsync -a --exclude '/swiftgpupack' --exclude '/swiftgpupack_*' \
    --exclude '/buffer_check' "$REPO/sim/" "$BUILDDIR/sim/"
  "$BUILDDIR/sim/make_buffer_layout_variants.sh" "$NODE" "$BINDIR" \
    --buffers "$BUFFER" $CUDA_FLAG -j 64 >> "$BUILDDIR/build.log" 2>&1 ||
    { tail -50 "$BUILDDIR/build.log"; exit 1; }
  # 5 splits x 10 layouts unless restricted via SPLITS/LAYOUTS (for tests)
  n_expected=50
  if [[ -n "${SPLITS:-}${LAYOUTS:-}" ]]; then
    n_expected=$(($(echo ${SPLITS:-x x x x x} | wc -w) * $(echo ${LAYOUTS:-x x x x x x x x x x} | wc -w)))
  fi
  n=$(ls "$BINDIR"/swiftgpupack_"$NODE"_*_global-var_*_"$BUFFER" 2> /dev/null | wc -l)
  [[ "$n" -ge "$n_expected" ]] || { echo "ERROR: only $n/$n_expected executables in $BINDIR"; exit 1; }
  # toolchain for the run jobs
  {
    echo "GH_MODULES='$GH_MODULES'"
    echo "GH_CUDA='$GH_CUDA'"
    echo "GH_CUDA_MODULE='${GH_CUDA_MODULE:-}'"
  } > "$TOOLCHAIN_ENV"
  echo "build done ($n executables), toolchain written to $TOOLCHAIN_ENV"

elif [[ "$MODE" == "run" ]]; then

  : "${DIR:?set DIR to the experiment directory, e.g. EAGLE25_72threads}"

  export OMP_PROC_BIND=true
  NTHREADS=36
  if [[ "$DIR" == *"_72thread"* ]]; then NTHREADS=72; fi
  export OMP_NUM_THREADS=$NTHREADS

  RESDIR="$RUNDIR/${NODE}_5steps_buffer-${BUFFER}"
  WORKDIR="$RUNDIR/work_${NODE}_${BUFFER}_${DIR}"
  mkdir -p "$RESDIR" "$WORKDIR"
  cd "$WORKDIR"
  rm -f results_*.csv

  part_access="global-var"

  for loop in "none" "by-struct" "by-element" "by-type" "by-struct-and-type"; do

    outdir="$RESDIR"/"$DIR"_"$part_access"_"$loop"_noflush
    mkdir -p "$outdir"

    for layout in aos soa upstream pack-gradient pack-force pack-shared pack-force-type random-order pack-gradient-type pack-shared-type; do

      outfile="$outdir"/results_"$layout".csv
      if [[ -f "$outfile" ]]; then
        echo "found $outfile, not rerunning"
        continue
      fi

      ex="$BINDIR"/swiftgpupack_"$NODE"_"$layout"_"$part_access"_"$loop"_"$BUFFER"
      echo "running $ex on $DIR"
      load_snapshot "before $DIR $loop $layout $BUFFER"
      "$LIKWID_PIN" --quiet -c N:0-"$((NTHREADS - 1))" \
        "$ex" -s 5 --noflush "$REPO/data/$DATANODE/$DIR"
      load_snapshot "after $DIR $loop $layout $BUFFER"
      mv results_"$layout".csv "$outfile"
      echo "written $outfile"
      if [[ -n "${STATUS_FILE:-}" ]]; then
        sed -i '/^last_finished_run=/d' "$STATUS_FILE"
        echo "last_finished_run=$(date -Is) $outfile" >> "$STATUS_FILE"
      fi

    done
  done

else
  echo "unknown MODE '$MODE'"
  exit 1
fi

echo "all done"

# Submission order used (from the results directory, REPO set):
#   b=$(sbatch --parsable --export=ALL,MODE=build,BUFFER=aos,REPO=$REPO job_buffer_layouts_gn003.slm)
#   for d in EAGLE25_72threads Gresho256_72threads EAGLE25_36threads Gresho256_36threads; do
#     sbatch --dependency=afterok:$b --kill-on-invalid-dep=yes \
#       --export=ALL,MODE=run,BUFFER=aos,DIR=$d,REPO=$REPO job_buffer_layouts_gn003.slm
#   done
# and the same for BUFFER=soa. A run job that hits the time limit can be
# resubmitted with the same command (finished runs are skipped).
